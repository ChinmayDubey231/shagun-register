# Copy to apps/api/.env for local development. On Render, set these in the dashboard.
PORT=4000
NODE_ENV=development

# MongoDB Atlas → Connect → Drivers. Must be a replica set (Atlas always is): sync uses transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/shagun?replicaSet=rs0

# Any long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# The *web* OAuth client ID (same value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID). Comma-separate to add iOS later.
GOOGLE_CLIENT_IDS=

# Email-only sign-in for emulators and local testing. Refused when NODE_ENV=production.
DEV_LOGIN=true

# Only for the Expo web preview (npm --workspace apps/mobile run web).
CORS_ORIGINS=http://localhost:8081
