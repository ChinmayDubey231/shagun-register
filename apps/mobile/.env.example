# Copy to .env (Expo loads it automatically). EXPO_PUBLIC_* values are baked into the app bundle.

# Where the API runs. Android emulator: http://10.0.2.2:4000
# Phone on the same Wi-Fi: http://<your computer's LAN IP>:4000. Release builds: your Render URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Google Cloud → Credentials → OAuth client ID of type "Web application".
# (Also create an "Android" client with package com.shagunregister.app and your SHA-1.)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Show email-only "Developer sign-in" (the API must also run with DEV_LOGIN=true). Never in release builds.
EXPO_PUBLIC_DEV_LOGIN=1

# iOS only, later: the reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc
# GOOGLE_IOS_URL_SCHEME=
