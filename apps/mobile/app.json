{
  "expo": {
    "name": "Shagun Register",
    "slug": "shagun-register",
    "scheme": "shagun",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shagunregister.app"
    },
    "android": {
      "package": "com.shagunregister.app",
      "adaptiveIcon": {
        "backgroundColor": "#7A1C2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4A51C"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Shagun Register uses your contacts to suggest names when you log a gift. Contacts are not uploaded."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Shagun Register uses the camera to read invite cards. Photos stay on your phone.",
          "photosPermission": "Shagun Register reads invite cards you choose from your photos. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Shagun Register uses Face ID to unlock when App lock is on."
        }
      ]
    ]
  }
}
